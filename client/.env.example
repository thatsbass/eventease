# Public API consumed by the Next.js client.
# Keep the /api suffix when the API is served under the same domain.
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Application base URL, used to generate links shared with attendees.
NEXT_PUBLIC_FRONT_URL="http://localhost:3000"

# Legacy public API path kept for compatibility with src/config/environment.ts.
NEXT_PUBLIC_API_PATH="/api"

# Avatar service base URL. This variable is optional when the default DiceBear URL is used.
DICEBEAR_URL="https://api.dicebear.com/9.x/glass/svg?seed="
